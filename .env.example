# =====================================================================
# VOLIA NIG LTD — Platform Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Vite + React)
# ---------------------------------------------------------------------
# Public canonical site URL
VITE_SITE_URL=https://volia.ng

# Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV=production

# Backend API Communication Mode
# Set to 'false' in production to communicate with the live Express API
# Set to 'true' during offline design review to use mock data fixtures
VITE_USE_MOCK_API=false

# Express Backend API Base URL
# In local development with Vite proxy: /api/v1
# In production: https://api.volia.ng/api/v1 (or reverse proxy /api/v1)
VITE_API_BASE_URL=/api/v1

# Maximum Candidate Document Upload Limit in Megabytes
VITE_MAX_UPLOAD_SIZE_MB=5

# Optional Analytics Tracking ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (Express on Node.js 22)
# ---------------------------------------------------------------------
# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=production

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGIN=https://volia.ng,https://staging.volia.ng

# Administrative Authentication Secret Key
JWT_SECRET=replace_with_secure_64_character_random_hex_string

# Document Upload Storage Directory
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE_BYTES=5242880

# SMTP / Email Notification Dispatcher (RFC 5322)
# When unset, notifications are recorded in local delivery logs without sending network mail
MAIL_HOST=smtp.volia.ng
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=careers@volia.ng
MAIL_PASSWORD=replace_with_smtp_credentials
MAIL_FROM_ADDRESS=careers@volia.ng
MAIL_FROM_NAME="VOLIA NIG LTD Recruitment Directorate"

# Nigerian Data Protection Act (NDPA 2023) Data Retention Window (Days)
NDPA_RETENTION_DAYS=730
